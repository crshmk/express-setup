{
  "name": "express-setup",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bd": "npm run build && npm run deploy",
    "build": "NODE_ENV=production babel src -d dist",
    "deploy": "./deploy.sh",
    "start": "nodemon -r dotenv/config --exec babel-node src/index.js",
    "test": "jest --watchAll --no-cache --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.5",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ramda": "^0.32.0",
    "socket.io": "^4.8.1"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/*.test.js"
    ],
    "globals": {
      "DB_HOST": "localhost"
    },
    "moduleNameMapper": {
      "~(.*)$": "<rootDir>/src/$1",
      "^app(.*)$": "<rootDir>/src/app$1",
      "^auth(.*)$": "<rootDir>/src/auth$1",
      "^routes(.*)$": "<rootDir>/src/routes$1"
    }
  }
}
